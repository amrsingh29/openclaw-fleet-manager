# Copy to .env and fill in. .env is gitignored.
#
# The Convex values are written for you by `npm run setup` against a local
# anonymous deployment. Leave them alone unless you are pointing at a hosted one.

# --- Model provider -----------------------------------------------------------
# Pick one. LLM_PROVIDER and LLM_MODEL override fleet.yml, which is what makes
# Docker and CI workable without editing files.

# OpenAI
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o

# Any OpenAI-compatible endpoint (gateway, OpenRouter, Groq, vLLM, ...)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=your-model-name

# Local, no API key needed
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
#
# Important: the model must support tool calling. `npm run doctor` checks this
# and tells you plainly if it does not.

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5

# --- Convex (written by setup) ------------------------------------------------
# CONVEX_DEPLOYMENT=anonymous:anonymous-agent
# CONVEX_URL=http://127.0.0.1:3210
# VITE_CONVEX_URL=http://127.0.0.1:3210
